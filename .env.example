DISCORD_TOKEN=your_bot_token_here
CLOUDFLARED_BIN=cloudflared

# Optional paths to host-installed media tools (not downloaded by the bot)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Movie web server
MOVIE_HOST=0.0.0.0
MOVIE_PORT=8080

# External Lavalink on Render
LAVALINK_URI=https://movie-bot-lavalink2.onrender.com
LAVALINK_PASSWORD=your_lavalink_password_here


# AI-generated Movie Bot replies (Groq is tried first; get a key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Temporarily disable Lavalink music backend
ENABLE_LAVALINK=false

# Optional Gemini fallback
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI-compatible fallback (not required)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# MOVIE_BOT_AI_MODEL=gpt-4o-mini
