DISCORD_TOKEN=your_bot_token_here
CLOUDFLARED_BIN=cloudflared

# Optional paths to host-installed media tools (not downloaded by the bot)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Movie web server
MOVIE_HOST=0.0.0.0
MOVIE_PORT=8080

# External Lavalink on Render
LAVALINK_URI=https://mallow-bot-lavalink2.onrender.com
LAVALINK_PASSWORD=your_lavalink_password_here


# Per-server command prefix and command enable/disable settings from the dashboard.
# Set the same random secret as Cloudflare Pages RUNTIME_CONFIG_SECRET.
MALLOW_DASHBOARD_CONFIG_URL=https://mallowbot.kz.ci/api/runtime-config
MALLOW_DASHBOARD_CONFIG_SECRET=replace_with_the_same_long_random_secret_as_cloudflare

# MallowCord two-way Discord bridge
MALLOWCORD_API_URL=https://mallowcord-api.wowgrayhaha.workers.dev/api
MALLOWCORD_SERVICE_KEY=
MALLOWCORD_DISCORD_GUILD_ID=1560367587542433812
MALLOWCORD_HISTORY_LIMIT=50
MALLOWCORD_OUTBOX_POLL_SECONDS=3

# Optional staged MallowCord Rust event ingestion.
# Set the private Rust service origin (not the Worker /api URL) and the exact
# same 32+ byte secret configured as MALLOWCORD_INTERNAL_EVENT_SECRET in Rust.
# When unset, Mallow-Bot continues using the existing Worker API routes.
MALLOWCORD_RUST_API_URL=
MALLOWCORD_INTERNAL_EVENT_SECRET=
