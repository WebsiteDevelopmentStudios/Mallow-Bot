DISCORD_TOKEN=your_bot_token_here
CLOUDFLARED_BIN=cloudflared

# Optional paths to host-installed media tools (not downloaded by the bot)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Movie web server
MOVIE_HOST=0.0.0.0
MOVIE_PORT=8080

# External Lavalink on Render
LAVALINK_URI=https://mallow-bot-lavalink2.onrender.com
LAVALINK_PASSWORD=your_lavalink_password_here


# Zoi AI model endpoints (OpenAI-compatible chat-completions API)
# The AI feature is off by default per server and only triggers on messages starting with "Movie Bot".
ZOI_API_URL=
ZOI_API_KEY=
ZOI_MODEL=zoi
ZOI_UNFILTERED_API_URL=
ZOI_UNFILTERED_API_KEY=
ZOI_UNFILTERED_MODEL=zoi-unfiltered
PREMIUM_CHECK_URL=https://mallowbot.kz.ci/api/premium-check

# Per-server command prefix and command enable/disable settings from the dashboard.
# Set the same random secret as Cloudflare Pages RUNTIME_CONFIG_SECRET.
MALLOW_DASHBOARD_CONFIG_URL=https://mallowbot.kz.ci/api/runtime-config
MALLOW_DASHBOARD_CONFIG_SECRET=replace_with_the_same_long_random_secret_as_cloudflare
