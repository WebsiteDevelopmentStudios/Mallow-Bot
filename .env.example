DISCORD_TOKEN=your_bot_token_here
WAKE_SECRET=replace_with_a_long_random_secret

# Dashboard runtime settings
MALLOW_DASHBOARD_CONFIG_URL=https://mallowbot.kz.ci/api/runtime-config
MALLOW_DASHBOARD_CONFIG_SECRET=replace_with_the_same_long_random_secret_as_cloudflare
PREMIUM_CHECK_URL=https://mallowbot.kz.ci/api/premium-check

# External Lavalink music service
ENABLE_LAVALINK=true
LAVALINK_URI=https://your-lavalink-host.example
LAVALINK_PASSWORD=your_lavalink_password_here

# Optional MCXboxBroadcast keep-alive
MCXBROADCAST_URL=
MCXBROADCAST_PING_INTERVAL=300

# Rust service
MALLOW_DATA_DIR=./data
PORT=25572
RUST_LOG=info
