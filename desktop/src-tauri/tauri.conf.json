{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MallowBot Panel",
  "version": "1.0.0",
  "identifier": "com.websitedevelopmentstudios.mallowbotpanel",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "MallowBot Panel",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SocialNetworking",
    "shortDescription": "MallowBot server management panel",
    "longDescription": "Desktop access to the hosted MallowBot dashboard.",
    "icon": []
  }
}
